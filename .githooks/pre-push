#!/usr/bin/env bash
# pre-push — affliate-api の安全機構をローカルで強制する層（ADR-011 / TASK-2026-07-31-201）
#
# 背景: GitHub Actions は課金しない方針のため CI は非稼働。安全機構の実効層はこのフックだけ。
#
# 設計方針: **軽い検査だけを置く**。push が重くなると `--no-verify` が常態化し、
#           本当に守りたい安全機構ごと無効化される。build / test / lint はここに入れない。
#
# 導入: ./scripts/install-hooks.sh （core.hooksPath=.githooks を設定）
# 緊急回避: git push --no-verify ← 使ったら workspace の memory/decisions.md に理由を記録

set -uo pipefail

# git-lfs への委譲（core.hooksPath が .git/hooks を影に入れるため肩代わり）
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@" || exit $?
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

FAIL=0
ok()  { printf '  ✓ %s\n' "$1"; }
bad() { printf '  ✗ %s\n' "$1"; FAIL=1; }

printf '\n=== pre-push: affliate-api 安全機構チェック ===\n'

# --- 1. オンチェーンガードの回帰 ---
# フロント/API でも、エージェントが誤ってオンチェーン操作を行う経路を塞ぐのが目的。
printf '[1/3] オンチェーンガード\n'
if grep -q 'Bash(cast send:\*)' .claude/settings.json 2>/dev/null \
   && grep -q 'Bash(forge script:\* --broadcast\*)' .claude/settings.json 2>/dev/null; then
  ok 'settings.json の deny ルールが健在'
else
  bad 'settings.json から deny ルールが消えている'
fi
if grep -q 'guard-dangerous.sh' .claude/settings.json 2>/dev/null; then
  ok 'PreToolUse ガードフックが配線されている'
else
  bad 'PreToolUse ガードフックが settings.json に無い'
fi
if [ -f .claude/hooks/guard-dangerous.test.sh ]; then
  if bash .claude/hooks/guard-dangerous.test.sh >/tmp/guard-test.$$ 2>&1; then
    ok 'ガード回帰テスト PASS'
  else
    bad 'ガード回帰テスト FAIL → 詳細:'; sed 's/^/      /' /tmp/guard-test.$$
  fi
  rm -f /tmp/guard-test.$$
else
  bad 'guard-dangerous.test.sh が無い（安全機構の回帰を検証できない）'
fi

# --- 2. シェル構文（自動化が無音で死ぬのを防ぐ）---
printf '[2/3] シェル構文\n'
SH_BAD=0
for f in .claude/hooks/*.sh .githooks/* scripts/*.sh; do
  [ -f "$f" ] || continue
  bash -n "$f" 2>/tmp/shn.$$ || { bad "構文エラー: $f"; sed 's/^/      /' /tmp/shn.$$; SH_BAD=1; }
done
rm -f /tmp/shn.$$
[ "$SH_BAD" -eq 0 ] && ok '.claude/hooks/ .githooks/ scripts/ すべて構文OK'

# --- 3. 秘密情報 ---
printf '[3/3] 秘密情報\n'
# `.env` および `.env.<環境名>` を検出。`.env.example` 等のテンプレートは正当なので除外。
ENV_HITS="$(git ls-files | grep -E '(^|/)\.env($|\.)' | grep -vE '\.(example|sample|template|dist)$' || true)"
if [ -n "$ENV_HITS" ]; then
  bad '.env が git に含まれている:'; printf '%s\n' "$ENV_HITS" | sed 's/^/      /'
else
  ok '.env はコミットされていない（.env.example 等のテンプレートは対象外）'
fi
SEC="$(git grep -nIE '(PRIVATE_KEY[[:space:]]*=[[:space:]]*"?0x[0-9a-fA-F]{64}|-----BEGIN [A-Z ]*PRIVATE KEY-----|github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{12,})' -- . ':(exclude)*.lock' ':(exclude)package-lock.json' 2>/dev/null || true)"
if [ -n "$SEC" ]; then
  bad '秘密鍵/トークンらしき文字列を検出:'; printf '%s\n' "$SEC" | sed 's/^/      /'
else
  ok '秘密鍵/トークンパターンなし'
fi

printf '\n'
if [ "$FAIL" -ne 0 ]; then
  printf '❌ pre-push 中断: 上記を修正してから push してください。\n'
  printf '   緊急時は git push --no-verify（使用したら workspace の memory/decisions.md に記録）\n\n'
  exit 1
fi
printf '✅ pre-push: 全チェック PASS\n\n'
exit 0
